<% content_for :title, "Enter Login Code - Travelogue" %>

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center px-4 py-8">
  <div class="w-full max-w-sm sm:max-w-md lg:max-w-lg bg-white rounded-lg shadow-lg p-6 sm:p-8">
    <div class="text-center mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Enter Login Code</h1>
      <p class="text-sm sm:text-base text-gray-600">
        We've sent a 6-digit code to <strong><%= @email %></strong>
      </p>
      <% if Rails.env.development? && @dev_code %>
        <div class="mt-4 p-4 bg-yellow-100 border border-yellow-400 rounded-lg">
          <p class="text-sm text-yellow-800 font-medium">Development Mode:</p>
          <p class="text-lg font-mono font-bold text-yellow-900">Your code is: <%= @dev_code %></p>
        </div>
      <% end %>
    </div>

    <%= tag.div(flash[:notice], class: "bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4") if flash[:notice] %>
    <%= tag.div(flash[:alert], class: "bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4") if flash[:alert] %>

    <%= form_with url: one_time_codes_path, local: true, class: "space-y-4 sm:space-y-6" do |form| %>
      <%= form.hidden_field :email, value: @email %>
      
      <div>
        <%= form.label :code, "6-Digit Code", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :code, 
            required: true, 
            autofocus: true, 
            placeholder: "123456", 
            maxlength: 6,
            pattern: "[0-9]{6}",
            class: "w-full px-4 py-3 border-2 border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 text-center text-2xl font-mono tracking-widest" %>
      </div>

      <div class="pt-2">
        <%= form.submit "Verify Code", 
            class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
      </div>
    <% end %>

    <div class="mt-6 text-center space-y-3">
      <%= link_to "Resend Code", resend_one_time_code_path(email: @email), 
          class: "text-blue-600 hover:text-blue-700 font-medium text-sm" %>
      
      <div class="text-xs text-gray-500">
        Code expires in 15 minutes
      </div>
      
      <div class="pt-2">
        <%= link_to "← Back to Sign In", new_user_path, 
            class: "text-gray-600 hover:text-gray-700 font-medium text-sm" %>
      </div>
    </div>
  </div>
</div>
