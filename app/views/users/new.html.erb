<% content_for :title, "Sign In - Travelogue" %>

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center px-4 py-8">
  <div class="w-full max-w-sm sm:max-w-md lg:max-w-lg bg-white rounded-lg shadow-lg p-6 sm:p-8">
    <div class="text-center mb-6 sm:mb-8">
      <h1 class="text-2xl sm:text-3xl font-bold text-gray-900 mb-2">Sign In</h1>
      <p class="text-sm sm:text-base text-gray-600">Enter your email to receive a login code</p>
    </div>

    <%= tag.div(flash[:notice], class: "bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4") if flash[:notice] && flash[:notice].include?("sent a login code") %>
    <%= tag.div(flash[:alert], class: "bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4") if flash[:alert] %>

    <%= form_with model: @user, local: true, class: "space-y-4 sm:space-y-6" do |form| %>
      <% if @user.errors.any? %>
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4" style="background-color: #fef2f2; border-color: #f87171; color: #dc2626;">
          <% @user.errors.full_messages.each do |message| %>
            <div><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <div>
        <%= form.label :email_address, class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.email_field :email_address, 
            required: true, 
            autofocus: true, 
            autocomplete: "email", 
            placeholder: "Enter your email address", 
            class: "w-full px-4 py-3 border-2 #{@user.errors[:email_address].any? ? 'border-red-500 bg-red-50 focus:ring-red-500 focus:border-red-500' : 'border-gray-300 focus:ring-blue-500 focus:border-blue-500'} rounded-lg shadow-sm focus:outline-none focus:ring-2",
            style: @user.errors[:email_address].any? ? "border-color: #ef4444; background-color: #fef2f2;" : "" %>
      </div>

      <div class="pt-2">
        <%= form.submit "Send Login Code", 
            class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2" %>
      </div>
    <% end %>

    <div class="mt-6 text-center">
      <p class="text-sm text-gray-600">
        New to Travelogue? Just enter your email above to get started!
      </p>
    </div>
  </div>
</div>
