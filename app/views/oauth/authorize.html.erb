<% content_for :title, "Authorize Application - Travelogue" %>

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center px-4 py-8">
  <div class="w-full max-w-md bg-white rounded-lg shadow-lg p-6 sm:p-8">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900 mb-2">Authorize Application</h1>
      <p class="text-gray-600">The application <strong><%= @application.name %></strong> wants to access your account.</p>
    </div>

    <div class="bg-gray-50 rounded-lg p-4 mb-6">
      <h3 class="font-medium text-gray-900 mb-2">Requested Permissions:</h3>
      <ul class="text-sm text-gray-600 space-y-1">
        <% if @scope&.include?('openid') %>
          <li>• Sign you in using your account</li>
        <% end %>
        <% if @scope&.include?('profile') %>
          <li>• Access your basic profile information</li>
        <% end %>
        <% if @scope&.include?('email') %>
          <li>• Access your email address</li>
        <% end %>
      </ul>
    </div>

    <div class="space-y-3">
      <%= form_with url: oauth_authorize_path, method: :post, local: true do |form| %>
        <%= form.hidden_field :consent, value: 'accept' %>
        <%= form.submit "Authorize", 
            class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-4 rounded-lg transition-colors duration-200" %>
      <% end %>

      <%= form_with url: oauth_authorize_path, method: :post, local: true do |form| %>
        <%= form.hidden_field :consent, value: 'deny' %>
        <%= form.submit "Deny", 
            class: "w-full bg-gray-600 hover:bg-gray-700 text-white font-medium py-3 px-4 rounded-lg transition-colors duration-200" %>
      <% end %>
    </div>

    <div class="mt-6 text-center">
      <p class="text-xs text-gray-500">
        You are signed in as <strong><%= Current.user.email_address %></strong>
      </p>
      <%= link_to "Sign out", session_path, method: :delete, 
          class: "text-blue-600 hover:text-blue-700 text-sm" %>
    </div>
  </div>
</div>
