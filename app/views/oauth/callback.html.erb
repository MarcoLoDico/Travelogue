<% content_for :title, "OAuth Callback - Travelogue" %>

<div class="min-h-screen bg-gradient-to-br from-blue-50 to-indigo-100 flex items-center justify-center px-4 py-8">
  <div class="w-full max-w-2xl bg-white rounded-lg shadow-lg p-6 sm:p-8">
    <div class="text-center mb-6">
      <h1 class="text-2xl font-bold text-gray-900 mb-0">Authorization Complete</h1>
      <p class="text-gray-600">OAuth authorization code received</p>
    </div>

    <div class="space-y-4">
      <% if params[:code] %>
        <div class="bg-green-50 rounded-lg p-4 border border-green-200">
          <h3 class="font-medium text-green-900 mb-2">✓ Authorization Code:</h3>
          <code class="text-sm bg-white p-2 rounded border block break-all text-green-800"><%= params[:code] %></code>
        </div>
      <% end %>

      <% if params[:error] %>
        <div class="bg-red-50 rounded-lg p-4 border border-red-200">
          <h3 class="font-medium text-red-900 mb-2">⚠️ Authorization Error:</h3>
          <code class="text-sm bg-white p-2 rounded border block text-red-800"><%= params[:error_description] || params[:error] %></code>
        </div>
      <% end %>

      <% if params[:state] %>
        <div class="bg-gray-50 rounded-lg p-4">
          <h3 class="font-medium text-gray-900 mb-2">State Parameter:</h3>
          <code class="text-sm bg-white p-2 rounded border block text-gray-800"><%= params[:state] %></code>
        </div>
      <% end %>

      <% if params[:code] %>
        <div class="bg-blue-50 rounded-lg p-4 border border-blue-200">
          <h3 class="font-medium text-blue-900 mb-2">Next: Exchange for Tokens</h3>
          <p class="text-sm text-blue-800 mb-3">
            The authorization code can now be exchanged for access and ID tokens:
          </p>
          <div class="bg-white p-3 rounded border text-xs font-mono text-gray-700">
            POST <a href="<%= request.base_url %>/oauth/token" target="_blank" class="text-blue-600 hover:underline">/oauth/token</a><br>
            grant_type=authorization_code<br>
            code=&lt;above_code&gt;<br>
            client_id=your_client_id<br>
            redirect_uri=<%= request.base_url %>/oauth/callback
          </div>
        </div>
      <% end %>

      <div class="flex space-x-4">
        <%= link_to "Return to Application", root_path, 
            class: "flex-1 bg-blue-600 hover:bg-blue-700 text-white font-medium py-2 px-4 rounded text-center" %>
      </div>
    </div>
  </div>
</div>