<% content_for :title, "Travelogue - Your Travel Journey" %>

<div class="container mx-auto px-4 py-8">
  <% if authenticated? %>
    <!-- Authenticated User View -->
    <div class="max-w-6xl mx-auto">
      <div class="flex justify-between items-center mb-8">
        <div>
          <h1 class="text-3xl font-bold text-gray-900">My Travels</h1>
          <p class="text-gray-600 mt-2">Places I've visited</p>
        </div>
        <div class="space-x-4">
          <%= link_to "Add Place", "#", class: "bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded" %>
          <%= link_to "Sign Out", session_path, data: { turbo_method: :delete }, class: "bg-gray-600 hover:bg-gray-700 text-white px-4 py-2 rounded" %>
        </div>
      </div>

      <% if @user_places.any? %>
        <div class="bg-white shadow rounded-lg overflow-hidden">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Place</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Country</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Visited</th>
                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Notes</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-200">
              <% @user_places.each do |visit| %>
                <tr class="hover:bg-gray-50">
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm font-medium text-gray-900"><%= visit.place.name %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-500"><%= visit.place.country_code %></div>
                  </td>
                  <td class="px-6 py-4 whitespace-nowrap">
                    <div class="text-sm text-gray-500">
                      <%= visit.visited_on&.strftime("%B %d, %Y") || visit.created_at.strftime("%B %d, %Y") %>
                    </div>
                  </td>
                  <td class="px-6 py-4">
                    <div class="text-sm text-gray-500">
                      <%= visit.notes.present? ? truncate(visit.notes, length: 100) : "—" %>
                    </div>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <!-- Empty State -->
        <div class="text-center py-12">
          <div class="text-gray-400 mb-4">
            <svg class="mx-auto h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-medium text-gray-900 mb-2">No places visited yet</h3>
          <p class="text-gray-500 mb-6">Start your travel journey by adding your first place!</p>
          <button class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded">
            Add Your First Place
          </button>
        </div>
      <% end %>
    </div>
  <% else %>
    <!-- Unauthenticated User View -->
    <div class="max-w-2xl mx-auto text-center">
      <div class="mb-8">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">Travelogue</h1>
        <p class="text-xl text-gray-600 mb-8">
          Document your travel journey and share your adventures
        </p>
      </div>

      <div class="bg-white rounded-lg shadow p-8 mb-8">
        <h2 class="text-2xl font-semibold text-gray-800 mb-6">Get Started</h2>
        <div class="space-y-4">
          <%= link_to "Sign In", new_session_path, class: "block w-full bg-blue-600 hover:bg-blue-700 text-white font-medium py-3 px-6 rounded" %>
          <%= link_to "Create Account", new_user_path, class: "block w-full bg-green-600 hover:bg-green-700 text-white font-medium py-3 px-6 rounded" %>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-6 text-center">
        <div class="p-4">
          <h3 class="font-semibold text-gray-800 mb-2">Track Places</h3>
          <p class="text-gray-600 text-sm">Keep a record of all the amazing places you've visited</p>
        </div>
        
        <div class="p-4">
          <h3 class="font-semibold text-gray-800 mb-2">Share Memories</h3>
          <p class="text-gray-600 text-sm">Share your travel experiences and memories with others</p>
        </div>
        
        <div class="p-4">
          <h3 class="font-semibold text-gray-800 mb-2">Discover</h3>
          <p class="text-gray-600 text-sm">Find new places to explore from other travelers</p>
        </div>
      </div>
    </div>
  <% end %>
</div>