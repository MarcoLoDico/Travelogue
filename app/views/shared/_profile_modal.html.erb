<div id="profile-modal" style="display: none;">
  <!-- Overlay backdrop - click to close -->
  <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.5); z-index: 9998;" data-action="click->profile-modal#close"></div>
  
  <!-- Modal content - positioned above backdrop -->
  <div style="position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 9999; overflow-y: auto; display: flex; align-items: center; justify-content: center; padding: 1rem;">
    <div class="w-full max-w-md bg-white rounded-lg shadow-lg mx-4" data-action="click->profile-modal#stayOpen" style="position: relative;">
      <div class="p-6 sm:p-8">
        <!-- Header -->
        <div class="text-center mb-6">
          <h1 class="text-2xl font-bold text-gray-900 mb-2">Profile</h1>
          <p class="text-gray-600">Manage your account settings</p>
        </div>

        <%= tag.div(flash[:notice], class: "bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4") if flash[:notice] %>
        <%= tag.div(flash[:alert], class: "bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4") if flash[:alert] %>

        <div class="space-y-4">
          <!-- User Info Section -->
          <div class="bg-gray-50 rounded-lg p-4 border border-gray-200 space-y-3">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Username</label>
              <p class="text-gray-900 font-bold text-lg"><%= Current.user.username %></p>
            </div>
            
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1">Email Address</label>
              <p class="text-gray-900 bg-white px-4 py-3 rounded-lg border-2 border-gray-300"><%= Current.user.email_address %></p>
            </div>
          </div>
          
          <!-- Public Profile Link -->
          <% if Current.user.username.present? %>
            <div class="pt-2">
              <%= link_to profile_path(username: Current.user.username), class: "flex items-center justify-center gap-2 w-full bg-emerald-600 hover:bg-emerald-700 text-white font-medium py-3 px-4 rounded-lg transition-colors duration-200" do %>
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/>
                </svg>
                View Public Profile
              <% end %>
              <p class="text-xs text-gray-500 text-center mt-2">Share your travel page: <%= profile_url(username: Current.user.username) %></p>
            </div>
          <% else %>
            <div class="pt-2">
              <p class="text-xs text-amber-600 text-center bg-amber-50 rounded-lg p-3 border border-amber-200">Set a username above to enable your public travel profile that you can share with others.</p>
            </div>
          <% end %>

          <!-- Sign Out Section -->
          <div class="pt-2 space-y-3">
            <p class="text-xs text-gray-500 text-center">Other users can view your display name and basic stats. Your email is private.</p>
            <%= button_to "Sign Out", session_path, method: :delete, class: "w-full bg-gray-600 hover:bg-gray-700 text-white font-medium py-3 px-4 rounded-lg transition-colors duration-200 cursor-pointer" %>
          </div>
        </div>

        <!-- Close button -->
        <button type="button" data-action="click->profile-modal#close" class="absolute top-4 right-4 text-gray-400 hover:text-gray-600 transition duration-200 p-1 cursor-pointer">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
    </div>
  </div>
</div>